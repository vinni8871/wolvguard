# Browser-safe Supabase config. Never put provider secrets in VITE_ variables.
VITE_SUPABASE_URL=https://lfreaxhmyjgudowgpwde.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here

# Server-only provider keys. Keep the actual values in the ignored .env file.
YOUTUBE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Apple Ads Platform OAuth. Upload the matching public key in Apple Ads first.
# Store PEM key newlines as literal \n sequences.
APPLE_ADS_CLIENT_ID=
APPLE_ADS_TEAM_ID=
APPLE_ADS_KEY_ID=
APPLE_ADS_AD_ACCOUNT_ID=
APPLE_ADS_PRIVATE_KEY=

# npm start serves the frontend + API on this port:
PORT=5173
